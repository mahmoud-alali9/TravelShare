<?xml version="1.0" encoding="utf-8"?>
<!-- item_banner_anonymous.xml -->
<!-- À insérer dans le RecyclerView comme premier item         -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_banner"
    android:padding="16dp"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="4dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Emoji globe + titre -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌍 Découvrez des milliers\nde photos de voyages"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.3"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Connectez-vous pour publier vos photos, créer des groupes et bien plus !"
            android:textColor="#E8E8FF"
            android:textSize="11sp"
            android:lineSpacingMultiplier="1.3"/>

    </LinearLayout>

    <!-- Bouton Se connecter -->
    <Button
        android:id="@+id/btn_connect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Se\nconnecter"
        android:textColor="#7C3AED"
        android:textSize="12sp"
        android:textStyle="bold"
        android:backgroundTint="#FFFFFF"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"/>

</LinearLayout>