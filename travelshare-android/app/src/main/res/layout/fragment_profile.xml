<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mon Profil"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:layout_marginBottom="24dp"/>

        <!-- État déconnecté -->
        <LinearLayout
            android:id="@+id/layout_profile_logged_out"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="50dp">

            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/ic_person"
                app:tint="#BDBDBD"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connectez-vous pour voir votre profil"
                android:layout_marginTop="16dp"
                android:textColor="#757575"/>

            <Button
                android:id="@+id/btn_profile_login"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Se connecter"
                android:layout_marginTop="16dp"
                android:backgroundTint="#7C3AED"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <!-- État connecté -->
        <LinearLayout
            android:id="@+id/layout_profile_logged_in"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Carte profil -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:elevation="2dp">

                <TextView
                    android:id="@+id/tv_profile_initial"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:gravity="center"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="24sp"
                    android:background="@drawable/circle_avatar"
                    android:backgroundTint="#059669"
                    android:text="U"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:id="@+id/tv_profile_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Utilisateur"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#212121"/>

                    <TextView
                        android:id="@+id/tv_profile_member_since"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Membre depuis 2024"
                        android:textSize="14sp"
                        android:textColor="#757575"/>
                </LinearLayout>
            </LinearLayout>

            <!-- En-tête section Mes photos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mes photos"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#212121"/>

                <TextView
                    android:id="@+id/tv_my_photos_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#757575"/>
            </LinearLayout>

            <!-- État vide galerie -->
            <TextView
                android:id="@+id/tv_no_photos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aucune photo publiée"
                android:textAlignment="center"
                android:textColor="#BDBDBD"
                android:paddingTop="24dp"
                android:paddingBottom="24dp"
                android:visibility="gone"/>

            <!-- Grille photos -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_my_photos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

            <!-- Actions -->
            <Button
                android:id="@+id/btn_my_subscriptions"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:text="Mes abonnements"
                android:textAllCaps="false"
                android:backgroundTint="#7C3AED"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/btn_logout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Se déconnecter"
                android:layout_marginTop="8dp"
                android:backgroundTint="#EF4444"
                android:textColor="#FFFFFF"/>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
