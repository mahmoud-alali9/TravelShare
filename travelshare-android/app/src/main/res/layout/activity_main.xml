<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- ── Toolbar globale ──────────────────────────────── -->
    <RelativeLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:layout_alignParentTop="true">

        <!-- Logo Avion à gauche -->
        <ImageView
            android:id="@+id/iv_logo_left"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_logo"
            app:tint="#7C3AED"
            android:padding="4dp"/>

        <!-- Titre de l'application au centre -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="TravelShare"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#212121"/>

        <!-- Zone Auth : soit bouton login, soit avatar (à droite) -->
        <RelativeLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <!-- Bouton connexion (personne grise) -->
            <ImageView
                android:id="@+id/btn_login"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_person"
                android:background="@drawable/bg_login_btn"
                android:padding="8dp"
                app:tint="#FFFFFF"
                android:visibility="visible"/>

            <!-- Avatar connecté (cercle vert/initiale) -->
            <LinearLayout
                android:id="@+id/layout_user_connected"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_user_initial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:background="@drawable/circle_avatar"
                    android:backgroundTint="#059669"/> <!-- Vert -->

            </LinearLayout>
        </RelativeLayout>

    </RelativeLayout>

    <!-- ── Container fragments ───────────────────────────── -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar"
        android:layout_above="@+id/bottom_nav"/>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        app:menu="@menu/bottom_nav_menu" />

</RelativeLayout>