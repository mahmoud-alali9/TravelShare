<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp">

    <androidx.cardview.widget.CardView
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── Photo ──────────────────────────────────── -->
            <ImageView
                android:id="@+id/img_photo"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:scaleType="centerCrop"
                android:contentDescription="Photo de voyage"/>

            <!-- ── Infos sous la photo ───────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Auteur -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Avatar rond -->
                    <TextView
                        android:id="@+id/tv_avatar"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:gravity="center"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:background="@drawable/circle_avatar"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">

                        <TextView
                            android:id="@+id/tv_author_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="#1A1A1A"/>

                        <TextView
                            android:id="@+id/tv_author_username"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="#9E9E9E"/>

                    </LinearLayout>

                    <!-- Bouton signaler -->
                    <ImageButton
                        android:id="@+id/btn_report"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_flag"
                        app:tint="#BDBDBD"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Signaler"/>

                </LinearLayout>

                <!-- Description -->
                <TextView
                    android:id="@+id/tv_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="14sp"
                    android:textColor="#1A1A1A"
                    android:lineSpacingMultiplier="1.3"
                    android:maxLines="3"
                    android:ellipsize="end"/>

                <!-- Localisation + date -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:src="@drawable/ic_location"
                        app:tint="#7C3AED"/>

                    <TextView
                        android:id="@+id/tv_location"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:textSize="12sp"
                        android:textColor="#616161"/>

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_marginStart="12dp"
                        android:src="@drawable/ic_calendar"
                        app:tint="#9E9E9E"/>

                    <TextView
                        android:id="@+id/tv_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:textSize="12sp"
                        android:textColor="#9E9E9E"/>

                </LinearLayout>

                <!-- Tags hashtag -->
                <LinearLayout
                    android:id="@+id/ll_tags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"/>

                <!-- ── Actions : like, commentaire, partage ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">

                    <!-- Like -->
                    <ImageButton
                        android:id="@+id/btn_like"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_favorite_border"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Aimer"/>

                    <TextView
                        android:id="@+id/tv_like_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:textSize="14sp"
                        android:textColor="#616161"/>

                    <!-- Commentaire -->
                    <ImageButton
                        android:id="@+id/btn_comment"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="16dp"
                        android:src="@drawable/ic_comment"
                        app:tint="#9E9E9E"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Commenter"/>

                    <TextView
                        android:id="@+id/tv_comment_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:textSize="14sp"
                        android:textColor="#616161"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"/>

                    <!-- Partager -->
                    <ImageButton
                        android:id="@+id/btn_share"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_share"
                        app:tint="#9E9E9E"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Partager"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>